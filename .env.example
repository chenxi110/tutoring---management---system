# ---- 上课通后端环境变量示例 ----
# 复制本文件为 .env 并填入真实密钥
FREEGPT_API_KEY=your_freegpt_key_here
FREECHAT_API_KEY=your_freechat_key_here

# CORS 允许的来源（逗号分隔，生产环境改为部署域名）
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# 服务端口
PORT=3001

# ---- JWT 认证配置 ----
# JWT 密钥（生产环境务必修改为随机长字符串）
JWT_SECRET=shangketong_secret_key_change_me_in_production
# Token 有效期（如 7d、24h、12h）
JWT_EXPIRES=7d

# ---- 家校群发消息模块（可选）----
# 短信推送（阿里云/腾讯云短信）
SMS_API_KEY=
SMS_SIGN_NAME=上课通
SMS_TEMPLATE_CODE=

# 微信公众号模板消息推送
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TEMPLATE_ID=
