# ============================================================================
# 上课通生产环境密钥模板 - 复制为 skt.env 并填入真实值
# ----------------------------------------------------------------------------
# 用途：被 systemd 的 EnvironmentFile 加载，注入到 skt-server 服务进程
# 安全：skt.env 必须权限 600、属主 root、绝不提交到 GitHub
#   sudo install -m 600 -o root -g root skt.env.example /etc/skt-server/skt.env
#   sudo nano /etc/skt-server/skt.env   # 填入真实密钥
# ============================================================================

# Agnes-AI 接口密钥（生产环境必填，jar 内不含明文密钥）
AI_API_KEY=sk-替换为真实密钥
AI_BASE_URL=https://apihub.agnes-ai.com/v1
AI_MODEL=agnes-ai

# 数据库（生产环境必填）
DB_URL=jdbc:mysql://localhost:3306/skt_db?useSSL=false&serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
DB_USERNAME=skt
DB_PASSWORD=替换为数据库密码

# JWT（生产环境必填，建议随机长串）
JWT_SECRET=替换为随机JWT密钥
